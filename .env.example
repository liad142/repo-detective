# Required. Never commit the real value.
OPENAI_API_KEY=

# Required. The model is configuration, never hardcoded in application code.
OPENAI_MODEL=

# Optional for OpenAI itself; required when using another OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. The application works without it, but GitHub then limits public REST calls.
GITHUB_TOKEN=

# Optional operational settings.
GITHUB_API_VERSION=2026-03-10
HTTP_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=120
GITHUB_CACHE_TTL_SECONDS=900
OSV_API_URL=https://api.osv.dev

# "required" forces a function call (OpenAI, Anthropic, Azure v1, most gateways).
# Set to "auto" only for providers that reject tool_choice=required; the app also
# downgrades automatically when it sees that specific HTTP 400.
OPENAI_TOOL_CHOICE=required

